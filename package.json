{
  "name": "servef",
  "private": true,
  "type": "module",
  "scripts": {
    "build:web": "vite build --configLoader native",
    "dev:server": "go run . testdata/markdown --port 8080 --no-open",
    "dev:web": "vite --configLoader native --port 5173 --strictPort",
    "dev": "pnpm build:web && pnpm run --parallel '/^dev:(server|web)$/'",
    "link:local": "pnpm build:web && go install .",
    "test:browser": "playwright test",
    "test:web": "node --test internal/web/*.test.ts internal/web/frontend/src/*.test.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@base-ui/react": "1.8.0",
    "@excalidraw/excalidraw": "0.18.1",
    "@excalidraw/mermaid-to-excalidraw": "2.2.2",
    "@fontsource-variable/inter": "5.3.0",
    "@tanstack/react-router": "1.170.33",
    "@tldraw/mermaid": "5.4.0",
    "class-variance-authority": "0.7.1",
    "cn": "0.2.6",
    "lucide-react": "1.43.0",
    "minisearch": "7.2.0",
    "react": "19.2.1",
    "react-dom": "19.2.1",
    "tldraw": "5.4.0"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "22.19.21",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.7",
    "@vitejs/plugin-react": "6.1.1",
    "tailwindcss": "4.3.3",
    "typescript": "7.0.2",
    "vite": "8.2.2"
  },
  "engines": {
    "node": ">=26 <27"
  },
  "packageManager": "pnpm@11.24.0"
}
